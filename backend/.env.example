# Copy to backend/.env and adjust. Every variable is optional for local development.
# Placeholders only — never commit real secrets.

# development | test | production (production refuses to start with the default JWT secret)
HF_ENVIRONMENT=development

# SQLite (default, zero setup) or PostgreSQL (see docker-compose.yml)
# HF_DATABASE_URL=sqlite:///./data/healthforce.db
# HF_DATABASE_URL=postgresql+psycopg://healthforce:healthforce@localhost:5432/healthforce

# Where uploaded files are stored (random names, per-organization folders)
# HF_UPLOAD_DIR=./data/uploads

# Session signing secret: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
HF_JWT_SECRET=replace-me-with-a-long-random-secret
HF_JWT_TTL_MINUTES=480
# Set true when served over HTTPS
HF_COOKIE_SECURE=false

# Extraction provider: "mock" (offline heuristic extractor, clearly labelled) or "groq" (gpt-oss-120b on Groq)
HF_EXTRACTION_PROVIDER=mock
HF_GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — reasoning depth for gpt-oss (higher = slower, more tokens)
HF_GROQ_REASONING_EFFORT=medium
HF_GROQ_TIMEOUT_SECONDS=90
# Required only when HF_EXTRACTION_PROVIDER=groq. Server-side only: never sent to the browser or logged.
# GROQ_API_KEY=gsk_...

# "simulated" enables a clearly labelled demo verification action; "disabled" allows manual primary-source records only
HF_VERIFICATION_MODE=simulated

HF_MAX_UPLOAD_BYTES=5242880
HF_MAX_JOB_ATTEMPTS=3
HF_EXPIRING_SOON_DAYS=60
HF_RUN_WORKER=true
